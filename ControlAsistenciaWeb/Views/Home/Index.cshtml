@{
    ViewData["Title"] = "Acceso Facial al Sistema";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso Facial al Sistema</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light d-flex align-items-center min-vh-100 py-4">

    <div class="container" style="max-width: 480px;">
        <div class="card shadow border-0 rounded-4 overflow-hidden">

            <div class="card-header bg-primary text-white text-center py-3">
                <h5 class="mb-0 fw-bold">Control de Asistencia</h5>
                <small class="opacity-75">Identificación Biométrica de Acceso</small>
            </div>

            <div class="card-body p-4 text-center">

                <!-- Visor de Cámara -->
                <div class="position-relative d-inline-block w-100 rounded-3 overflow-hidden bg-black mb-3" style="height: 340px;">
                    <video id="video" autoplay playsinline muted class="w-100 h-100" style="object-fit: cover; transform: scaleX(-1);"></video>
                </div>

                <!-- Identificación en Tiempo Real -->
                <div class="p-3 mb-3 bg-light rounded-3 border text-start">
                    <span class="text-muted d-block small">Usuario detectado:</span>
                    <span id="lblNombre" class="h5 fw-bold text-secondary mb-0">Buscando rostro...</span>
                    <small id="lblDistancia" class="d-block text-muted mt-1" style="font-size: 0.8rem;"></small>
                </div>

                <div id="estadoMensaje" class="alert alert-info py-2 mb-0 small">
                    Iniciando red neuronal...
                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/face-api.js@@0.22.2/dist/face-api.min.js"></script>

    <script>
        const video = document.getElementById('video');
        const estadoMensaje = document.getElementById('estadoMensaje');
        const lblNombre = document.getElementById('lblNombre');
        const lblDistancia = document.getElementById('lblDistancia');

        let baseUsuarios = [];
        let faceMatcher = null;
        let loginEnProgreso = false;

        async function inicializar() {
            try {
                const MODEL_URL = 'https://raw.githubusercontent.com/justadudewhohacks/face-api.js/master/weights';

                await faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL);
                await faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL);
                await faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL);

                await recargarDescriptores();

                const stream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: "user", width: { ideal: 640 }, height: { ideal: 480 } },
                    audio: false
                });
                video.srcObject = stream;

                video.addEventListener('play', () => {
                    estadoMensaje.className = 'alert alert-success py-2 mb-0 small';
                    estadoMensaje.textContent = 'Cámara activa. Mire fijamente al lente.';
                    iniciarEscaneo();
                });

            } catch (error) {
                estadoMensaje.className = 'alert alert-danger py-2 mb-0 small';
                estadoMensaje.textContent = 'Error: ' + error.message;
            }
        }

        async function recargarDescriptores() {
            try {
                const res = await fetch('/api/asistencia/usuarios-rostros');
                baseUsuarios = await res.json();

                const labeled = [];
                baseUsuarios.forEach(u => {
                    if (u.descriptorFacial) {
                        try {
                            const desc = new Float32Array(JSON.parse(u.descriptorFacial));
                            labeled.push(new faceapi.LabeledFaceDescriptors(u.id.toString(), [desc]));
                        } catch (e) {
                            console.error("Error al procesar descriptor", u.id);
                        }
                    }
                });

                if (labeled.length > 0) {
                    faceMatcher = new faceapi.FaceMatcher(labeled, 0.65);
                } else {
                    faceMatcher = null;
                }
            } catch (e) {
                console.error("Error al cargar descriptores", e);
            }
        }

        function iniciarEscaneo() {
            const timer = setInterval(async () => {
                if (video.paused || video.ended || loginEnProgreso) return;

                const detection = await faceapi.detectSingleFace(video, new faceapi.TinyFaceDetectorOptions())
                    .withFaceLandmarks()
                    .withFaceDescriptor();

                if (detection && faceMatcher) {
                    const match = faceMatcher.findBestMatch(detection.descriptor);
                    lblDistancia.textContent = `Margen: ${match.distance.toFixed(3)} (umbral: 0.650)`;

                    if (match.label !== 'unknown') {
                        const usuario = baseUsuarios.find(u => u.id.toString() === match.label);
                        if (usuario) {
                            loginEnProgreso = true;
                            lblNombre.textContent = usuario.nombreCompleto;
                            lblNombre.className = "h5 fw-bold text-success mb-0";
                            estadoMensaje.className = 'alert alert-primary py-2 mb-0 small';
                            estadoMensaje.textContent = 'Identidad confirmada. Ingresando...';

                            setTimeout(async () => {
                                try {
                                    const resp = await fetch('/api/asistencia/login-facial', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({ usuarioId: usuario.id, tipo: 0 })
                                    });
                                    const data = await resp.json();
                                    if (data.exito) {
                                        window.location.href = data.redirectUrl;
                                    }
                                } catch (err) {
                                    loginEnProgreso = false;
                                    alert("Error al iniciar sesión: " + err.message);
                                }
                            }, 1000);
                            return;
                        }
                    }
                    lblNombre.textContent = "Rostro no registrado";
                    lblNombre.className = "h5 fw-bold text-warning mb-0";
                } else if (!detection) {
                    lblNombre.textContent = "Buscando rostro...";
                    lblNombre.className = "h5 fw-bold text-secondary mb-0";
                    lblDistancia.textContent = "";
                }
            }, 600);
        }

        window.addEventListener('DOMContentLoaded', inicializar);
    </script>
</body>
</html>G