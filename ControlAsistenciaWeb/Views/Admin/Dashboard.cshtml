@{
    ViewData["Title"] = "Panel Recursos Humanos";
    var atrasos = ViewBag.Atrasos as List<ControlAsistenciaWeb.Models.ReporteAtrasoItem> ?? new();
    var salidas = ViewBag.Salidas as List<ControlAsistenciaWeb.Models.ReporteSalidaAnticipadaItem> ?? new();
    var inasistencias = ViewBag.Inasistencias as List<ControlAsistenciaWeb.Models.ReporteInasistenciaItem> ?? new();
    var usuarios = ViewBag.Usuarios as List<ControlAsistenciaWeb.Models.Usuario> ?? new();
    var justificaciones = ViewBag.Justificaciones as List<ControlAsistenciaWeb.Models.JustificacionReporteItem> ?? new();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel de Administración y RRHH</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light pb-5">

    <nav class="navbar navbar-dark bg-dark shadow-sm mb-4">
        <div class="container">
            <span class="navbar-brand fw-bold mb-0">🏢 Portal Recursos Humanos & Administración</span>
            <a href="/" class="btn btn-sm btn-outline-light">Cerrar Sesión</a>
        </div>
    </nav>

    <div class="container">

        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Exito"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Pestañas de Navegación -->
        <ul class="nav nav-pills mb-4 nav-justified" id="pills-tab" role="tablist">
            <li class="nav-item">
                <button class="nav-link active fw-semibold" id="tab-reportes-btn" data-bs-toggle="pill" data-bs-target="#tab-reportes">📊 Reportes de Asistencia</button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-semibold" id="tab-justificaciones-btn" data-bs-toggle="pill" data-bs-target="#tab-justificaciones">📄 Licencias Médicas (@justificaciones.Count)</button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-semibold" id="tab-usuarios-btn" data-bs-toggle="pill" data-bs-target="#tab-usuarios">👥 Gestión de Personal & Enrolamiento</button>
            </li>
        </ul>

        <div class="tab-content" id="pills-tabContent">

            <!-- PESTAÑA 1: REPORTES -->
            <div class="tab-pane fade show active" id="tab-reportes">
                <div class="card shadow-sm border-0 p-3 mb-4">
                    <form method="get" class="row g-2 align-items-center">
                        <div class="col-auto"><label class="col-form-label fw-bold">Desde:</label></div>
                        <div class="col-auto"><input type="date" name="fechaDesde" value="@ViewBag.FechaDesde" class="form-control form-control-sm" /></div>
                        <div class="col-auto"><label class="col-form-label fw-bold">Hasta:</label></div>
                        <div class="col-auto"><input type="date" name="fechaHasta" value="@ViewBag.FechaHasta" class="form-control form-control-sm" /></div>
                        <div class="col-auto"><button type="submit" class="btn btn-sm btn-primary">Filtrar</button></div>
                    </form>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-warning text-dark fw-bold">Atrasos (> 09:30)</div>
                            <ul class="list-group list-group-flush small">
                                @foreach (var a in atrasos)
                                {
                                    <li class="list-group-item d-flex justify-content-between">
                                        <div><strong>@a.NombreCompleto</strong><br><span class="text-muted">@a.FechaHoraEntrada.ToString("dd/MM HH:mm")</span></div>
                                        <span class="badge bg-danger align-self-center">+@a.MinutosAtraso min</span>
                                    </li>
                                }
                                @if (atrasos.Count == 0)
                                {
                                    <li class="list-group-item text-muted text-center">Sin atrasos</li>
                                }
                            </ul>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-info text-dark fw-bold">Salidas Anticipadas (< 17:30)</div>
                            <ul class="list-group list-group-flush small">
                                @foreach (var s in salidas)
                                {
                                    <li class="list-group-item d-flex justify-content-between">
                                        <div><strong>@s.NombreCompleto</strong><br><span class="text-muted">@s.FechaHoraSalida.ToString("dd/MM HH:mm")</span></div>
                                        <span class="badge bg-warning text-dark align-self-center">-@s.MinutosAnticipacion min</span>
                                    </li>
                                }
                                @if (salidas.Count == 0)
                                {
                                    <li class="list-group-item text-muted text-center">Sin salidas tempranas</li>
                                }
                            </ul>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-danger text-white fw-bold">Inasistencias</div>
                            <ul class="list-group list-group-flush small">
                                @foreach (var i in inasistencias)
                                {
                                    <li class="list-group-item d-flex justify-content-between">
                                        <div><strong>@i.NombreCompleto</strong><br><span class="text-muted">@i.Correo</span></div>
                                        <span class="badge bg-secondary align-self-center">Falta</span>
                                    </li>
                                }
                                @if (inasistencias.Count == 0)
                                {
                                    <li class="list-group-item text-muted text-center">Asistencia completa</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PESTAÑA 2: JUSTIFICACIONES MÉDICAS -->
            <div class="tab-pane fade" id="tab-justificaciones">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white fw-bold py-3">Bandeja de Licencias y Documentos Médicos</div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 small">
                                <thead class="table-light">
                                    <tr>
                                        <th>Empleado</th>
                                        <th>Fecha Ausencia</th>
                                        <th>Motivo</th>
                                        <th>Fecha Envío</th>
                                        <th>Documento</th>
                                        <th>Estado RRHH</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (justificaciones.Count == 0)
                                    {
                                        <tr><td colspan="7" class="text-center text-muted py-4">No hay justificaciones registradas.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var j in justificaciones)
                                        {
                                            <tr>
                                                <td><strong>@j.NombreCompleto</strong><br><span class="text-muted">@j.Correo</span></td>
                                                <td>@j.FechaAusencia.ToString("dd/MM/yyyy")</td>
                                                <td><span class="badge bg-light text-dark border">@j.Motivo</span></td>
                                                <td>@j.FechaSubida.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td>
                                                    <a href="@j.RutaArchivo" target="_blank" class="btn btn-sm btn-outline-primary">
                                                        📄 Ver / Descargar
                                                    </a>
                                                </td>
                                                <td>
                                                    @if (j.Estado == 1)
                                                    {
                                                        <span class="badge bg-success">Aprobada</span>
                                                        @if (!string.IsNullOrEmpty(j.ComentarioRRHH))
                                                        {
                                                            <small class="d-block text-muted">@j.ComentarioRRHH</small>
                                                        }
                                                    }
                                                    else if (j.Estado == 2)
                                                    {
                                                        <span class="badge bg-danger">Rechazada</span>
                                                        @if (!string.IsNullOrEmpty(j.ComentarioRRHH))
                                                        {
                                                            <small class="d-block text-muted">@j.ComentarioRRHH</small>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">Pendiente</span>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    @if (j.Estado == 0)
                                                    {
                                                        <div class="d-inline-flex gap-1">
                                                            <form asp-action="CambiarEstadoJustificacion" method="post" class="d-inline">
                                                                <input type="hidden" name="id" value="@j.Id" />
                                                                <input type="hidden" name="nuevoEstado" value="1" />
                                                                <input type="hidden" name="comentario" value="Aprobado por RRHH" />
                                                                <button type="submit" class="btn btn-sm btn-success fw-bold" title="Aprobar">✓ Aprobar</button>
                                                            </form>
                                                            <form asp-action="CambiarEstadoJustificacion" method="post" class="d-inline">
                                                                <input type="hidden" name="id" value="@j.Id" />
                                                                <input type="hidden" name="nuevoEstado" value="2" />
                                                                <input type="hidden" name="comentario" value="Rechazado por RRHH" />
                                                                <button type="submit" class="btn btn-sm btn-danger fw-bold" title="Rechazar">✕ Rechazar</button>
                                                            </form>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">Revisado (@j.FechaRevision?.ToString("dd/MM"))</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PESTAÑA 3: GESTIÓN DE PERSONAL & ENROLAMIENTO -->
            <div class="tab-pane fade" id="tab-usuarios">
                <div class="row g-4">
                    <!-- Formulario Nuevo Empleado -->
                    <div class="col-md-5">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-white fw-bold py-3">➕ Registrar Nuevo Colaborador</div>
                            <div class="card-body">
                                <form asp-action="CrearUsuario" method="post">
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold">Nombre Completo</label>
                                        <input type="text" name="nombreCompleto" class="form-control form-control-sm" placeholder="Ej: Juan Pérez" required />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold">Correo Electrónico</label>
                                        <input type="email" name="correo" class="form-control form-control-sm" placeholder="juan@empresa.cl" required />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold">Rol Asignado</label>
                                        <select name="rol" class="form-select form-select-sm">
                                            <option value="0">Trabajador / Empleado</option>
                                            <option value="1">Administrador / Recursos Humanos</option>
                                        </select>
                                    </div>
                                    <button type="submit" class="btn btn-success btn-sm w-100 fw-bold">Guardar Empleado</button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Lista de Empleados con Acciones (Enrolar / Eliminar) -->
                    <div class="col-md-7">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-white fw-bold py-3">👥 Personal Activo & Enrolamiento Facial</div>
                            <div class="card-body p-0">
                                <ul class="list-group list-group-flush small">
                                    @foreach (var u in usuarios)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                            <div>
                                                <strong>#@u.Id - @u.NombreCompleto</strong><br>
                                                <span class="text-muted">@u.Correo</span>
                                                <span class="badge ms-2 @(u.RolUsuario == ControlAsistenciaWeb.Models.Rol.administrador ? "bg-primary" : "bg-secondary")">
                                                    @u.RolUsuario
                                                </span>
                                            </div>
                                            <div class="d-inline-flex gap-2">
                                                <!-- Botón para Enrolar Rostro -->
                                                <button type="button" class="btn btn-sm btn-outline-primary fw-semibold"
                                                        onclick="abrirModalEnrolar(@u.Id, '@u.NombreCompleto')">
                                                    📸 Enrolar Rostro
                                                </button>

                                                <!-- Formulario para Eliminar/Dar de baja -->
                                                <form asp-action="EliminarUsuario" method="post" onsubmit="return confirm('¿Seguro que deseas dar de baja a @u.NombreCompleto?');">
                                                    <input type="hidden" name="id" value="@u.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger fw-bold" title="Eliminar">🗑</button>
                                                </form>
                                            </div>
                                        </li>
                                    }
                                    @if (usuarios.Count == 0)
                                    {
                                        <li class="list-group-item text-center text-muted py-4">No hay personal registrado.</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- MODAL DE ENROLAMIENTO CON CÁMARA (ADMIN) -->
    <div class="modal fade" id="modalEnrolarAdmin" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h6 class="modal-title fw-bold" id="modalEnrolarTitulo">Enrolar Rostro</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" onclick="detenerCamara()"></button>
                </div>
                <div class="modal-body text-center">
                    <p class="small text-muted mb-2">Ubique al empleado frente a la cámara y pulse <strong>Capturar y Guardar</strong>.</p>

                    <div class="position-relative d-inline-block w-100 rounded-3 overflow-hidden bg-black mb-3" style="height: 280px;">
                        <video id="videoAdmin" autoplay playsinline muted class="w-100 h-100" style="object-fit: cover; transform: scaleX(-1);"></video>
                    </div>

                    <div id="estadoModal" class="alert alert-secondary py-2 small mb-0">Cámara lista...</div>
                    <input type="hidden" id="usuarioIdParaEnrolar" value="" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" onclick="detenerCamara()">Cancelar</button>
                    <button type="button" id="btnCapturarRostroAdmin" class="btn btn-primary btn-sm fw-bold">Capturar y Guardar Rostro</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/face-api.js@@0.22.2/dist/face-api.min.js"></script>

    <script>
            let modalStream = null;
            const videoAdmin = document.getElementById('videoAdmin');
            const estadoModal = document.getElementById('estadoModal');
            const btnCapturar = document.getElementById('btnCapturarRostroAdmin');
            let modelosCargados = false;

            async function cargarModelos() {
                if (!modelosCargados) {
                    const MODEL_URL = 'https://raw.githubusercontent.com/justadudewhohacks/face-api.js/master/weights';
                    await faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL);
                    await faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL);
                    await faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL);
                    modelosCargados = true;
                }
            }

            async function abrirModalEnrolar(usuarioId, nombre) {
                document.getElementById('modalEnrolarTitulo').textContent = `Enrolar Rostro: ${nombre}`;
                document.getElementById('usuarioIdParaEnrolar').value = usuarioId;
                estadoModal.className = 'alert alert-info py-2 small mb-0';
                estadoModal.textContent = 'Iniciando cámara y modelos...';

                const modal = new bootstrap.Modal(document.getElementById('modalEnrolarAdmin'));
                modal.show();

                await cargarModelos();

                try {
                    modalStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
                    videoAdmin.srcObject = modalStream;
                    estadoModal.className = 'alert alert-success py-2 small mb-0';
                    estadoModal.textContent = 'Mire a la cámara e intente no moverse.';
                } catch (err) {
                    estadoModal.className = 'alert alert-danger py-2 small mb-0';
                    estadoModal.textContent = 'No se pudo acceder a la cámara: ' + err.message;
                }
            }

            function detenerCamara() {
                if (modalStream) {
                    modalStream.getTracks().forEach(track => track.stop());
                    modalStream = null;
                }
            }

            btnCapturar.addEventListener('click', async () => {
                const userId = document.getElementById('usuarioIdParaEnrolar').value;
                if (!userId) return;

                btnCapturar.disabled = true;
                estadoModal.className = 'alert alert-warning py-2 small mb-0';
                estadoModal.textContent = 'Analizando rostro...';

                const detection = await faceapi.detectSingleFace(videoAdmin, new faceapi.TinyFaceDetectorOptions())
                    .withFaceLandmarks()
                    .withFaceDescriptor();

                if (!detection) {
                    estadoModal.className = 'alert alert-danger py-2 small mb-0';
                    estadoModal.textContent = 'No se detectó un rostro claro. Mire fijamente.';
                    btnCapturar.disabled = false;
                    return;
                }

                try {
                    const descriptorArray = Array.from(detection.descriptor);
                    const resp = await fetch('/api/asistencia/registrar-rostro', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            usuarioId: parseInt(userId),
                            descriptorFacial: JSON.stringify(descriptorArray)
                        })
                    });

                    const data = await resp.json();
                    if (data.exito) {
                        estadoModal.className = 'alert alert-success py-2 small mb-0';
                        estadoModal.textContent = '¡Rostro guardado exitosamente!';
                        setTimeout(() => {
                            detenerCamara();
                            bootstrap.Modal.getInstance(document.getElementById('modalEnrolarAdmin')).hide();
                            btnCapturar.disabled = false;
                            window.location.reload();
                        }, 1200);
                    } else {
                        estadoModal.className = 'alert alert-danger py-2 small mb-0';
                        estadoModal.textContent = 'Error: ' + data.mensaje;
                        btnCapturar.disabled = false;
                    }
                } catch (err) {
                    estadoModal.className = 'alert alert-danger py-2 small mb-0';
                    estadoModal.textContent = 'Error de conexión: ' + err.message;
                    btnCapturar.disabled = false;
                }
            });
    </script>
</body>
</html>